{
  "name": "slimza_backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "node -e \"if (!require('fs').existsSync('dist/main.js')) require('child_process').execSync('npm run build', {stdio:'inherit'})\" && prisma migrate deploy && node dist/main.js",
    "build": "prisma generate && nest build",
    "migrate:deploy": "prisma migrate deploy",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node -e \"if (!require('fs').existsSync('dist/main.js')) require('child_process').execSync('npm run build', {stdio:'inherit'})\" && prisma migrate deploy && node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node -e \"if (!require('fs').existsSync('dist/main.js')) require('child_process').execSync('npm run build', {stdio:'inherit'})\" && prisma migrate deploy && node dist/main.js",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "pm2:start": "npm run build && pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop slimza-backend",
    "pm2:restart": "npm run build && pm2 restart slimza-backend",
    "pm2:logs": "pm2 logs slimza-backend",
    "pm2:status": "pm2 status"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1177.0",
    "@aws-sdk/s3-request-presigner": "^3.1178.0",
    "@nestjs/cli": "^12.0.13",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/mapped-types": "*",
    "@nestjs/observe": "^0.3.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^8.2.0",
    "ioredis": "^6.0.0",
    "mariadb": "^3.5.5",
    "node-fetch": "^3.3.2",
    "nodemailer": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^23.1.0",
    "typescript": "^6.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "prisma": "^7.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "fsevents@2.3.3": true
  }
}
