# Database Configuration
# Option A: GoDaddy Managed MySQL discrete environment variables (Recommended for GoDaddy)
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="slimza"
DB_USER="slimza_admin"
DB_PASSWORD="secret123"

# Option B: Standard Connection URL (Local development / Docker)
DATABASE_URL="mysql://slimza_admin:secret123@localhost:3306/slimza"

# Server Port & CORS
PORT=5173
CORS_ORIGIN="http://localhost:3000"

# JWT Secrets (replace in production!)
JWT_ACCESS_SECRET="dev-slimza-access-secret-change-in-production"
JWT_REFRESH_SECRET="dev-slimza-refresh-secret-change-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_DAYS=30
JWT_SHORT_REFRESH_EXPIRES_DAYS=1

# Cookie settings
COOKIE_SECURE=false
COOKIE_SAME_SITE="lax"

# SMTP Mailer (if omitted, OTP codes are logged to backend console in dev)
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Slimza <no-reply@slimza.com>"

# Seeded Admin (used by `npm run seed` / `npx prisma db seed`)
ADMIN_EMAIL="admin@slimza.com"
ADMIN_PASSWORD="Admin@12345"
ADMIN_NAME="Slimza Admin"
