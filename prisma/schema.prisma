generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum OtpPurpose {
  SIGNUP
  RESET
}

model User {
  id                  String         @id @default(uuid())
  name                String
  firstName           String         @default("")
  lastName            String         @default("")
  email               String         @unique
  passwordHash        String
  phone               String         @default("")
  birthday            String         @default("")
  avatarUrl           String         @default("")
  role                UserRole       @default(CUSTOMER)
  isEmailVerified     Boolean        @default(false)
  emailVerifiedAt     DateTime?
  deletionRequestedAt DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  addresses           Address[]
  otpCodes            OtpCode[]
  refreshTokens       RefreshToken[]
  orders              Order[]
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  label     String   @default("Address")
  name      String
  line1     String
  line2     String?
  city      String
  postcode  String
  country   String
  phone     String   @default("")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OtpCode {
  id                  String     @id @default(uuid())
  userId              String
  email               String
  purpose             OtpPurpose
  codeHash            String
  attempts            Int        @default(0)
  expiresAt           DateTime
  verifiedAt          DateTime?
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  consumedAt          DateTime?
  createdAt           DateTime   @default(now())
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose])
  @@index([userId, purpose])
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  rememberMe Boolean   @default(true)
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CmsSection {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model NewsletterLead {
  id           String   @id @default(uuid())
  email        String   @unique
  source       String   @default("Footer Newsletter")
  status       String   @default("Subscribed")
  subscribedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  REFUNDED
}

model Order {
  id              String        @id @default(uuid())
  orderNumber     String        @unique
  userId          String?
  customerEmail   String
  customerName    String
  customerPhone   String        @default("")
  shippingAddress Json
  shippingMethod  String        @default("uk-standard")
  shippingFee     Float         @default(0)
  subtotal        Float
  discount        Float         @default(0)
  bundleSavings   Float         @default(0)
  bundleReward    Float         @default(0)
  promoCode       String?
  total           Float
  currency        String        @default("gbp")
  status          OrderStatus   @default(PROCESSING)
  paymentStatus   PaymentStatus @default(PENDING)
  paymentMode     String        @default("stripe")
  paymentIntentId String?       @unique
  stripeChargeId  String?
  metadata        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  refundRequest   RefundRequest?

  @@index([userId])
  @@index([customerEmail])
  @@index([paymentIntentId])
  @@index([orderNumber])
}

model RefundRequest {
  id             String       @id @default(uuid())
  orderId        String       @unique
  userId         String?
  customerEmail  String
  customerName   String
  amount         Float
  currency       String       @default("gbp")
  reason         String       @db.Text
  status         RefundStatus @default(REQUESTED)
  adminNote      String?      @db.Text
  stripeRefundId String?
  processedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([customerEmail])
  @@index([createdAt])
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String
  productId    String
  productName  String
  productImage String   @default("")
  sizeLabel    String?
  planLabel    String?
  quantity     Int      @default(1)
  unitPrice    Float
  totalPrice   Float
  isBundle     Boolean  @default(false)
  bundleData   Json?
  createdAt    DateTime @default(now())

  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
}

model Product {
  id              String   @id @default(uuid())
  slug            String   @unique
  name            String
  description     String   @db.Text
  price           Float
  originalPrice   Float?
  discountPercent Float    @default(0)
  taxIncluded     Boolean  @default(true)
  unlimitedStock  Boolean  @default(false)
  stockQuantity   Int      @default(50)
  stockStatus     String   @default("In Stock") // "In Stock" | "Low Stock" | "Out of Stock"
  category        String   @default("cleanse-reset")
  categories      Json?
  brand           String   @default("slimza-teas")
  tags            Json?
  publishStatus   String   @default("published") // "published" | "draft"
  featured        Boolean  @default(false)
  featuredRank    Int      @default(99)
  offered         Boolean  @default(false)
  rating          Float    @default(5.0)
  reviewCount     Int      @default(12)
  image           String   @default("/products/tea/teatox-green.png")
  gallery         Json?
  sizes           Json?
  variations      Json?
  supplyDuration  String?  @default("1 Month")
  packsPerMonth   Int?     @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([slug])
  @@index([category])
  @@index([publishStatus])
  @@index([featured])
}

model Coupon {
  id              String   @id @default(uuid())
  code            String   @unique
  discountPercent Float
  customerRange   Int      @default(100)
  uses            Int      @default(0)
  generateDate    String
  expiredDate     String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([code])
}

model MediaAsset {
  id        String   @id @default(uuid())
  folder    String
  filename  String
  mimeType  String
  size      Int
  data      Bytes    @db.LongBlob
  createdAt DateTime @default(now())

  @@unique([folder, filename])
  @@index([folder])
}
