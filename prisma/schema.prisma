generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum OtpPurpose {
  SIGNUP
  RESET
}

model User {
  id                  String         @id @default(uuid())
  name                String
  firstName           String         @default("")
  lastName            String         @default("")
  email               String         @unique
  passwordHash        String
  phone               String         @default("")
  birthday            String         @default("")
  avatarUrl           String         @default("")
  role                UserRole       @default(CUSTOMER)
  isEmailVerified     Boolean        @default(false)
  emailVerifiedAt     DateTime?
  deletionRequestedAt DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  addresses           Address[]
  otpCodes            OtpCode[]
  refreshTokens       RefreshToken[]
  orders              Order[]
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  label     String   @default("Address")
  name      String
  line1     String
  line2     String?
  city      String
  postcode  String
  country   String
  phone     String   @default("")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OtpCode {
  id                  String     @id @default(uuid())
  userId              String
  email               String
  purpose             OtpPurpose
  codeHash            String
  attempts            Int        @default(0)
  expiresAt           DateTime
  verifiedAt          DateTime?
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  consumedAt          DateTime?
  createdAt           DateTime   @default(now())
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose])
  @@index([userId, purpose])
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  rememberMe Boolean   @default(true)
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CmsSection {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model NewsletterLead {
  id           String   @id @default(uuid())
  email        String   @unique
  source       String   @default("Footer Newsletter")
  status       String   @default("Subscribed")
  subscribedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Order {
  id              String        @id @default(uuid())
  orderNumber     String        @unique
  userId          String?
  customerEmail   String
  customerName    String
  customerPhone   String        @default("")
  shippingAddress Json
  shippingMethod  String        @default("uk-standard")
  shippingFee     Float         @default(0)
  subtotal        Float
  discount        Float         @default(0)
  bundleSavings   Float         @default(0)
  bundleReward    Float         @default(0)
  promoCode       String?
  total           Float
  currency        String        @default("gbp")
  status          OrderStatus   @default(PROCESSING)
  paymentStatus   PaymentStatus @default(PENDING)
  paymentMode     String        @default("stripe")
  paymentIntentId String?       @unique
  stripeChargeId  String?
  metadata        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  items           OrderItem[]

  @@index([userId])
  @@index([customerEmail])
  @@index([paymentIntentId])
  @@index([orderNumber])
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String
  productId    String
  productName  String
  productImage String   @default("")
  sizeLabel    String?
  planLabel    String?
  quantity     Int      @default(1)
  unitPrice    Float
  totalPrice   Float
  isBundle     Boolean  @default(false)
  bundleData   Json?
  createdAt    DateTime @default(now())

  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
}
