generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

/// Whether a user may use their account. See src/users/account-access.ts.
enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum OtpPurpose {
  SIGNUP
  RESET
}

model User {
  id                  String               @id @default(uuid())
  name                String
  firstName           String               @default("")
  lastName            String               @default("")
  email               String               @unique
  passwordHash        String
  phone               String               @default("")
  birthday            String               @default("")
  avatarUrl           String               @default("")
  role                UserRole             @default(CUSTOMER)
  isEmailVerified     Boolean              @default(false)
  emailVerifiedAt     DateTime?
  deletionRequestedAt DateTime?
  /// The customer deleted their own account (Account → Settings). Soft delete: archivedAt is set
  /// too, so the account is blocked and listed under Archived; an admin can restore it.
  deletedAt           DateTime?
  /// Optional reason the customer gave when deleting
  deletionReason      String?              @db.Text
  /// SUSPENDED = cannot sign in, buy or pay. Set by an admin; reversible.
  status              UserStatus           @default(ACTIVE)
  suspendedAt         DateTime?
  suspensionReason    String?              @db.Text
  /// Archive lifecycle (src/common/archive/archive.ts). Archived users cannot sign in either.
  archivedAt          DateTime?
  /// Loyalty: spendable points (sum of AVAILABLE ledger entries). Kept in sync by LoyaltyService.
  loyaltyPoints       Int                  @default(0)
  /// Loyalty: points ever earned (drives the tier). Redemptions don't lower it; reversals do.
  loyaltyLifetime     Int                  @default(0)
  /// Store credit in GBP (sum of WalletTransaction.amount). Kept in sync by WalletService.
  walletBalance       Float                @default(0)
  /// Stripe Customer that holds this user's saved cards (created on first use).
  stripeCustomerId    String?              @unique
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  addresses           Address[]
  otpCodes            OtpCode[]
  refreshTokens       RefreshToken[]
  orders              Order[]
  loyaltyTransactions LoyaltyTransaction[]
  walletTransactions  WalletTransaction[]
  walletCards         WalletCard[]
  productReviews      ProductReview[]

  @@index([status])
  @@index([archivedAt])
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  label     String   @default("Address")
  name      String
  line1     String
  line2     String?
  city      String
  /// District / county (optional)
  district  String   @default("")
  postcode  String
  country   String
  phone     String   @default("")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OtpCode {
  id                  String     @id @default(uuid())
  userId              String
  email               String
  purpose             OtpPurpose
  codeHash            String
  attempts            Int        @default(0)
  expiresAt           DateTime
  verifiedAt          DateTime?
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  consumedAt          DateTime?
  createdAt           DateTime   @default(now())
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose])
  @@index([userId, purpose])
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  rememberMe Boolean   @default(true)
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CmsSection {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model NewsletterLead {
  id           String    @id @default(uuid())
  email        String    @unique
  source       String    @default("Footer Newsletter")
  status       String    @default("Subscribed")
  subscribedAt DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  /// Soft-delete marker. null = live; set = archived (hidden, restorable). See src/common/archive/archive.ts
  archivedAt   DateTime?

  @@index([archivedAt])
}

/// Placed (automatic, every new order) → Processing → Shipped → Delivered; or Cancelled.
/// Admins move orders along in Dashboard → Orders. Delivered (and paid) lets the customer review the products.
enum OrderStatus {
  PLACED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  REFUNDED
}

model Order {
  id              String        @id @default(uuid())
  orderNumber     String        @unique
  userId          String?
  customerEmail   String
  customerName    String
  customerPhone   String        @default("")
  shippingAddress Json
  shippingMethod  String        @default("uk-standard")
  shippingFee     Float         @default(0)
  subtotal        Float
  discount        Float         @default(0)
  bundleSavings   Float         @default(0)
  bundleReward    Float         @default(0)
  /// Loyalty points spent on this order, and the £ they took off
  pointsRedeemed  Int           @default(0)
  pointsDiscount  Float         @default(0)
  /// Loyalty points this order earns (pending until delivered)
  pointsEarned    Int           @default(0)
  /// Store credit (wallet) used on this order, in GBP. The card was charged total - walletUsed.
  walletUsed      Float         @default(0)
  promoCode       String?
  total           Float
  currency        String        @default("gbp")
  status          OrderStatus   @default(PLACED)
  paymentStatus   PaymentStatus @default(PENDING)
  paymentMode     String        @default("stripe")
  /// How it was paid, as shown to the customer ("Visa •••• 4242", "Store credit")
  paymentLabel    String        @default("")
  paymentIntentId String?       @unique
  stripeChargeId  String?
  metadata        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  /// Soft-delete marker. null = live; set = archived (hidden, restorable). See src/common/archive/archive.ts
  archivedAt      DateTime?

  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  refundRequest RefundRequest?

  @@index([userId])
  @@index([customerEmail])
  @@index([paymentIntentId])
  @@index([orderNumber])
  @@index([archivedAt])
}

model RefundRequest {
  id             String       @id @default(uuid())
  orderId        String       @unique
  userId         String?
  customerEmail  String
  customerName   String
  amount         Float
  currency       String       @default("gbp")
  reason         String       @db.Text
  status         RefundStatus @default(REQUESTED)
  adminNote      String?      @db.Text
  stripeRefundId String?
  processedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([customerEmail])
  @@index([createdAt])
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String
  productId    String
  productName  String
  productImage String   @default("")
  sizeLabel    String?
  planLabel    String?
  quantity     Int      @default(1)
  unitPrice    Float
  totalPrice   Float
  isBundle     Boolean  @default(false)
  bundleData   Json?
  createdAt    DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
}

model Product {
  id              String    @id @default(uuid())
  slug            String    @unique
  name            String
  description     String    @db.Text
  price           Float
  originalPrice   Float?
  discountPercent Float     @default(0)
  taxIncluded     Boolean   @default(true)
  unlimitedStock  Boolean   @default(false)
  stockQuantity   Int       @default(50)
  stockStatus     String    @default("In Stock") // "In Stock" | "Low Stock" | "Out of Stock"
  category        String    @default("cleanse-reset")
  categories      Json?
  brand           String    @default("slimza-teas")
  tags            Json?
  publishStatus   String    @default("published") // "published" | "draft"
  featured        Boolean   @default(false)
  featuredRank    Int       @default(99)
  offered         Boolean   @default(false)
  /// Average of PUBLISHED reviews (0 = none yet). Kept in sync by ReviewsService.
  rating          Float     @default(0)
  /// Number of PUBLISHED reviews. Kept in sync by ReviewsService.
  reviewCount     Int       @default(0)
  image           String    @default("/products/tea/teatox-green.png")
  gallery         Json?
  sizes           Json?
  variations      Json?
  supplyDuration  String?   @default("1 Month")
  packsPerMonth   Int?      @default(1)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  /// Soft-delete marker. null = live; set = archived (hidden, restorable). See src/common/archive/archive.ts
  archivedAt      DateTime?
  productReviews  ProductReview[]

  @@index([slug])
  @@index([category])
  @@index([publishStatus])
  @@index([featured])
  @@index([archivedAt])
  @@index([price])
  /// Full-text search (src/products/product-search.ts): one index per searchable column,
  /// plus one on both for relevance ranking.
  @@fulltext([name])
  @@fulltext([description])
  @@fulltext([name, description])
}

model Coupon {
  id              String    @id @default(uuid())
  code            String    @unique
  discountPercent Float
  customerRange   Int       @default(100)
  uses            Int       @default(0)
  generateDate    String
  expiredDate     String
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  /// Soft-delete marker. null = live; set = archived (hidden, restorable). See src/common/archive/archive.ts
  archivedAt      DateTime?

  @@index([code])
  @@index([archivedAt])
}

model MediaAsset {
  id        String   @id @default(uuid())
  folder    String
  filename  String
  mimeType  String
  size      Int
  data      Bytes    @db.LongBlob
  createdAt DateTime @default(now())

  @@unique([folder, filename])
  @@index([folder])
}

/// What the applicant wants to become. See src/franchise/franchise.schemas.ts.
enum FranchiseInterest {
  FRANCHISE
  SALES_REPRESENTATIVE
}

/// Where they want to sell.
enum FranchiseChannel {
  ONLINE
  RETAIL
  BOTH
}

/// Admin pipeline for an application.
enum FranchiseApplicationStatus {
  NEW
  CONTACTED
  APPROVED
  REJECTED
}

/// Submitted from the public "Franchise with us" page (/franchise).
/// Reviewed in the dashboard (Franchise). Follows the archive lifecycle.
model FranchiseApplication {
  id           String                     @id @default(uuid())
  fullName     String
  email        String
  phone        String
  address      String                     @db.Text
  businessName String?
  /// Country they want to sell in
  country      String
  /// City / region / area within that country
  location     String
  interest     FranchiseInterest
  channel      FranchiseChannel
  message      String?                    @db.Text
  status       FranchiseApplicationStatus @default(NEW)
  /// Internal note, never shown to the applicant
  adminNote    String?                    @db.Text
  /// Archive lifecycle (src/common/archive/archive.ts)
  archivedAt   DateTime?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt

  @@index([status])
  @@index([archivedAt])
  @@index([createdAt])
  @@index([email])
}

/// Blog posts, managed from Dashboard → Blogs. `content` is Markdown.
/// Archive lifecycle (src/common/archive/archive.ts): archived posts are hidden from the shop.
model Blog {
  id          String    @id @default(uuid())
  slug        String    @unique
  title       String    @db.VarChar(300)
  /// Short summary for cards and SEO
  excerpt     String    @db.Text
  /// Article body in Markdown (## heading, ### subheading, - list, > quote, **bold**)
  content     String    @db.LongText
  image       String    @db.VarChar(1000)
  author      String    @default("Slimza")
  /// Blog category slug (CMS section "blog_categories")
  category    String    @default("")
  publishedAt DateTime
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([category])
  @@index([publishedAt])
  @@index([archivedAt])
}

enum LoyaltyEntryType {
  WELCOME
  PURCHASE
  PURCHASE_REVERSAL
  REDEEM
  REDEEM_RETURN
  BIRTHDAY
  SOCIAL
  ADMIN
}

enum LoyaltyEntryStatus {
  /// Earned but not spendable yet (order not delivered)
  PENDING
  /// Counted in User.loyaltyPoints
  AVAILABLE
  /// Never became spendable (order cancelled before delivery)
  CANCELLED
}

/// Loyalty points ledger (src/loyalty). One row per change; `points` is signed.
/// `referenceKey` is unique, so the same bonus / order can never be applied twice.
model LoyaltyTransaction {
  id           String             @id @default(uuid())
  userId       String
  type         LoyaltyEntryType
  status       LoyaltyEntryStatus @default(AVAILABLE)
  points       Int
  description  String             @db.VarChar(300)
  orderId      String?
  referenceKey String             @unique @db.VarChar(191)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([orderId])
  @@index([type])
}

/// What changed a customer's store credit (src/wallet).
enum WalletEntryType {
  /// Added by an admin (goodwill, compensation…)
  ADMIN_CREDIT
  /// Removed by an admin
  ADMIN_DEBIT
  /// An order refunded to store credit instead of the card
  REFUND
  /// Spent on an order at checkout
  ORDER_PAYMENT
  /// Credit given back when an order that used it was cancelled / refunded
  ORDER_RETURN
}

/// Store-credit ledger. One row per change; `amount` is signed (GBP). `referenceKey` is unique,
/// so the same order payment / return can never be booked twice.
model WalletTransaction {
  id           String          @id @default(uuid())
  userId       String
  type         WalletEntryType
  amount       Float
  balanceAfter Float
  description  String          @db.VarChar(300)
  orderId      String?
  referenceKey String          @unique @db.VarChar(191)
  /// Admin who made the change (ADMIN_* / REFUND)
  createdById  String?
  createdAt    DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([orderId])
}

/// Saved cards when Stripe is NOT configured (test / demo mode). Only what a receipt shows:
/// brand, last 4 and expiry — never the card number or CVC. With Stripe on, cards live in Stripe.
model WalletCard {
  id        String   @id @default(uuid())
  userId    String
  brand     String   @db.VarChar(40)
  last4     String   @db.VarChar(4)
  expMonth  Int
  expYear   Int
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Visible = shown on the product page; Hidden = taken down by an admin (the customer still sees it as hidden).
enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

/// A customer's review of one product (src/reviews). One per customer per product; they can edit it.
/// Product.rating / Product.reviewCount are recalculated from PUBLISHED, non-archived reviews.
model ProductReview {
  id               String       @id @default(uuid())
  productId        String
  /// null once the customer's account is deleted (the review stays, under authorName)
  userId           String?
  /// Shown publicly, e.g. "Sarah M."
  authorName       String
  rating           Int
  title            String       @default("")
  body             String       @db.Text
  status           ReviewStatus @default(PUBLISHED)
  /// The customer had a paid order containing this product when they reviewed it
  verifiedPurchase Boolean      @default(false)
  /// Shown in the homepage "What Our Customers Say" section
  featured         Boolean      @default(false)
  featuredAt       DateTime?
  /// Public reply from Slimza, shown under the review
  adminReply       String?      @db.Text
  adminReplyAt     DateTime?
  /// The admin changed the customer's wording (shown as "Edited by Slimza")
  editedByAdmin    Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  /// Archive lifecycle (src/common/archive/archive.ts)
  archivedAt       DateTime?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([productId, userId])
  @@index([productId, status, archivedAt])
  @@index([featured, status])
  @@index([createdAt])
}
