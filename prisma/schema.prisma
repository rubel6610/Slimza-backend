generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum OtpPurpose {
  SIGNUP
  RESET
}

model User {
  id                  String         @id @default(uuid())
  name                String
  firstName           String         @default("")
  lastName            String         @default("")
  email               String         @unique
  passwordHash        String
  phone               String         @default("")
  birthday            String         @default("")
  avatarUrl           String         @default("")
  role                UserRole       @default(CUSTOMER)
  isEmailVerified     Boolean        @default(false)
  emailVerifiedAt     DateTime?
  deletionRequestedAt DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  addresses           Address[]
  otpCodes            OtpCode[]
  refreshTokens       RefreshToken[]
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  label     String   @default("Address")
  name      String
  line1     String
  line2     String?
  city      String
  postcode  String
  country   String
  phone     String   @default("")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OtpCode {
  id                  String     @id @default(uuid())
  userId              String
  email               String
  purpose             OtpPurpose
  codeHash            String
  attempts            Int        @default(0)
  expiresAt           DateTime
  verifiedAt          DateTime?
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  consumedAt          DateTime?
  createdAt           DateTime   @default(now())
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose])
  @@index([userId, purpose])
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  rememberMe Boolean   @default(true)
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CmsSection {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model NewsletterLead {
  id           String   @id @default(uuid())
  email        String   @unique
  source       String   @default("Footer Newsletter")
  status       String   @default("Subscribed")
  subscribedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
